# Production infra/.env on the server (F4-13, D065; docs/f4/implantacao.md).
# Set the domain and the e-mail, and replace every secret with the output of
# `node infra/gen-secrets.mjs`: infra/check-env.mjs refuses this file as it is.
# Secrets use only letters, digits, _ and -, 24 or more, without quotes.
# The real file stays on the server, never in the repository.
NAKAMA_DOMAIN=jogo.example.com
ACME_EMAIL=voce@example.com
NAKAMA_SERVER_KEY=troque-pela-saida-do-gen-secrets
NAKAMA_HTTP_KEY=troque-pela-saida-do-gen-secrets
NAKAMA_SESSION_KEY=troque-pela-saida-do-gen-secrets
NAKAMA_CONSOLE_PASSWORD=troque-pela-saida-do-gen-secrets
POSTGRES_PASSWORD=troque-pela-saida-do-gen-secrets
SIM_SECRET=troque-pela-saida-do-gen-secrets
