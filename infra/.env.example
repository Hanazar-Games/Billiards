# Development values only. npm run infra:up copies this file to infra/.env
# (ignored by git). Production keys live in the server's environment (D049),
# never in the repository.
POSTGRES_PASSWORD=dev-postgres
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_HTTP_KEY=dev-http-key
NAKAMA_SESSION_KEY=dev-session-key
NAKAMA_CONSOLE_PASSWORD=dev-console
