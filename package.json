{
  "name": "billiards-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/client",
    "build": "npm run build -w apps/client",
    "build:pages": "npm run build:pages -w apps/client",
    "test:pages": "npm run test:pages -w apps/client",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
